{
    "hosting": [
        {
            "target": "main",
            "source": ".",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache, no-store, must-revalidate"
                        }
                    ]
                },
                {
                    "source": "/_next/static/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                }
            ],
            "frameworksBackend": {
                "region": "southamerica-east1",
                "memory": "512MiB"
            }
        },
        {
            "target": "eastside",
            "source": ".",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache, no-store, must-revalidate"
                        }
                    ]
                },
                {
                    "source": "/_next/static/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                }
            ],
            "frameworksBackend": {
                "region": "southamerica-east1",
                "memory": "512MiB"
            }
        },
        {
            "target": "site-cliente",
            "source": ".",
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/node_modules/**"
            ],
            "headers": [
                {
                    "source": "**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "no-cache, no-store, must-revalidate"
                        }
                    ]
                },
                {
                    "source": "/_next/static/**",
                    "headers": [
                        {
                            "key": "Cache-Control",
                            "value": "public, max-age=31536000, immutable"
                        }
                    ]
                }
            ],
            "frameworksBackend": {
                "region": "southamerica-east1",
                "memory": "512MiB"
            }
        }
    ],
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ]
        }
    ],
    "firestore": [
        {
            "database": "salaodadudu7",
            "rules": "firestore.rules",
            "indexes": "firestore.indexes.json"
        },
        {
            "database": "studiobarber",
            "rules": "firestore.rules",
            "indexes": "firestore.indexes.json"
        }
    ],
    "storage": {
        "rules": "storage.rules"
    }
}
