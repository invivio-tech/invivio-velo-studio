{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)", "Bash(npm install:*)", "Bash(npm run:*)", "Bash(npm test:*)", "Bash(npm audit:*)",
      "Bash(npx tsc:*)", "Bash(npx vitest:*)", "Bash(npx playwright:*)", "Bash(npx eslint:*)",
      "Bash(bash scripts/ci/ratchet.sh:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git fetch:*)", "Bash(git checkout:*)",
      "Bash(git add:*)", "Bash(git commit:*)", "Bash(git push:*)", "Bash(git pull:*)", "Bash(git branch:*)", "Bash(git grep:*)",
      "Bash(gh issue:*)", "Bash(gh pr:*)", "Bash(gh run:*)", "Bash(gh label:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(**/.env)", "Read(**/.env.*)",
      "Read(**/service-account*.json)", "Read(**/*-key.json)", "Read(**/*.pem)",
      "Bash(firebase deploy:*)", "Bash(npx firebase deploy:*)", "Bash(npx firebase-tools deploy:*)",
      "Bash(git push --force:*)", "Bash(git push origin client/:*)", "Bash(git push origin main:*)", "Bash(git push origin HEAD:main:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(gh pr merge:*)", "Bash(gh pr review --approve:*)", "Bash(gh repo delete:*)",
      "Bash(npm publish:*)", "Bash(curl:*)", "Bash(wget:*)"
    ]
  }
}
